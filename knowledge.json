    {
      "id": "k-afe24edf",
      "type": "memory",
      "kind": "constraint",
      "content": "Conductor's auto-launch logic must use both process detection (tasklist) and file locking. Never trust port-check alone.",
      "why": "The exe takes several seconds to bind port 5000 after launching. A port-check alone races during that window and can spawn multiple Conductor instances. Multiple instances = multiple schedulers firing the same cron = cascading subprocess explosions.",
      "tags": [
        "mcp",
        "auto-launch",
        "race-condition",
        "fork-bomb",
        "context-keeper"
      ],
      "scope": "team",
      "project": "Conductor",
      "source": {
        "system": "context-keeper",
        "ref": "con-004"
