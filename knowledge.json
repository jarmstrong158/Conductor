    },
    {
      "id": "k-2c3a8113",
      "type": "memory",
      "kind": "constraint",
      "content": "The AppData DB is the source of truth: C:/Users/jarms/AppData/Roaming/Redis Operator/conductor.db",
      "why": "The exe reads from AppData. The repo has its own conductor.db which is stale. All MCP interactions go through the exe which uses the AppData DB.",
