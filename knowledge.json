    {
      "id": "k-13d4bdc4",
      "type": "memory",
      "kind": "constraint",
      "content": "All subprocess-spawning scripts (SMTP, HTTP, etc.) must have explicit timeouts",
      "why": "Without a timeout, a hung network call keeps the subprocess alive forever. When a scheduler fires repeatedly, dead subprocesses stack up and exhaust resources.",
      "tags": [
        "subprocess",
        "timeout",
        "fork-bomb",
        "stability",
        "context-keeper"
      ],
