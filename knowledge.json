    {
      "id": "k-fa84280b",
      "type": "memory",
      "kind": "constraint",
      "content": "Never run Conductor from source (python launch.py). Always use the installed exe at %APPDATA%/Redis Operator/Conductor.exe",
      "why": "Source and exe use different SQLite databases. Running from source creates/modifies a different conductor.db than the one the exe uses, causing workers to go missing or duplicate.",
      "tags": [
        "exe",
        "database",
        "deployment",
        "context-keeper"
      ],
      "scope": "team",
      "project": "Conductor",
      "source": {
        "system": "context-keeper",
        "ref": "con-001"
      },
      "created_by": "jonny-desktop",
